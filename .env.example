# ---- LLM / Embeddings (OpenAI) ----
OPENAI_API_KEY=sk-...

# ---- News (Tavily) ----
TAVILY_API_KEY=tvly-...

# ---- Vector store (Qdrant Cloud or self-hosted) ----
# For Qdrant Cloud: https://xyz-abc.cloud.qdrant.io:6333
# For local docker:  http://localhost:6333  (leave QDRANT_API_KEY empty)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Optional overrides ----
# Chat model used by the Analyst & Writer nodes
CHAT_MODEL=gpt-4o
# OpenAI embedding model (1536 dims) — keep in sync with EMBEDDING_DIM in config.py
EMBEDDING_MODEL=text-embedding-3-small

# ---- API protection (matters once the API is public) ----
# Browser origins allowed to call the API, comma-separated. "*" allows any;
# in production set this to the frontend's URL (plus localhost for local dev):
#   ALLOWED_ORIGINS=https://equity-research-agent-six.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*
# Optional regex for origins whose hostname changes per deployment (Vercel previews):
#   ALLOWED_ORIGIN_REGEX=https://equity-research-agent-[a-z0-9]+-stephanie-xie-s-projects\.vercel\.app
ALLOWED_ORIGIN_REGEX=
# New research runs per client IP per hour / in total per day (0 = unlimited).
# Cached reports don't count.
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=200
# Minutes a finished report is served from cache (0 = never cache).
CACHE_TTL_MINUTES=60

# SEC EDGAR requires a User-Agent in "Name email@domain" format (their fair-access
# policy). Parenthetical or browser-like User-Agents are rejected with HTTP 403.
SEC_USER_AGENT=Your Name your_email@example.com
